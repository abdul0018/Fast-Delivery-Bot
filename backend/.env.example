# ===== Telegram =====
BOT_TOKEN=123456789:replace-with-your-bot-token
# Buyurtmalar tushadigan admin/guruh chat ID (guruh: -100xxxxxxxxxx)
ADMIN_CHAT_ID=
ADMIN_LANGUAGE=uz
# Mini App manzili (faqat HTTPS), masalan Vercel'dagi frontend
WEBAPP_URL=https://your-mini-app.vercel.app
SUPPORT_PHONE=+998 90 000 00 00

# ===== Database (Neon PostgreSQL) =====
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require&channel_binding=require
DB_LOGGING=false

# ===== API server =====
PORT=4000
# Vergul bilan: https://your-mini-app.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Faqat lokal test uchun (Telegramsiz brauzerda): true
ALLOW_DEV_AUTH=false

# ===== To'lovlar =====
# BotFather -> /mybots -> Payments -> Payme yoki Click provider token (bo'sh bo'lsa Payme/Click o'chiq)
PAYMENT_PROVIDER_TOKEN=
# Order Bump narxi (so'm)
ORDER_BUMP_PRICE=5000
MIN_ORDER_TOTAL=0

LOG_LEVEL=info
