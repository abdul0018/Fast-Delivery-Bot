# ===== Rejim =====
# Lokal: development | Server: production (production'da xavfli sozlamalar bilan server ishga tushmaydi)
NODE_ENV=development

# ===== Telegram =====
BOT_TOKEN=123456789:replace-with-your-bot-token
# Buyurtmalar tushadigan admin/guruh chat ID (guruh: -100xxxxxxxxxx).
# Bilish uchun: botni guruhga qo'shing va guruhda /id yuboring.
# Production'da bu bo'sh bo'lsa buyurtmalar qabul qilinmaydi (yo'qolib ketmasligi uchun).
ADMIN_CHAT_ID=
ADMIN_LANGUAGE=uz
# Mini App manzili (faqat HTTPS), masalan Vercel'dagi frontend
WEBAPP_URL=https://your-mini-app.vercel.app
SUPPORT_PHONE=+998 90 000 00 00
# Webhook rejimi (Render/Railway): backend'ning HTTPS manzili. Bo'sh qoldirilsa — long polling (VPS yoki lokal)
WEBHOOK_DOMAIN=
# Ixtiyoriy: webhook maxfiy kaliti (bo'sh bo'lsa BOT_TOKEN dan avtomatik hosil qilinadi)
WEBHOOK_SECRET=

# ===== Database (Neon PostgreSQL) =====
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=verify-full
DB_LOGGING=false

# ===== API server =====
PORT=4000
# Mini App domeni (vergul bilan bir nechta): https://your-mini-app.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Faqat lokal test uchun (Telegramsiz brauzerda): true. Production'da avtomatik o'chiq.
ALLOW_DEV_AUTH=false

# ===== Buyurtmalar va to'lovlar =====
# Hozircha faqat naqd pul. Payme/Click ni yoqish uchun: BotFather -> /mybots -> Payments -> provider token
PAYMENT_PROVIDER_TOKEN=
# Order Bump narxi (so'm)
ORDER_BUMP_PRICE=5000
MIN_ORDER_TOTAL=0
# Bitta foydalanuvchi 10 daqiqada nechta buyurtma bera oladi
MAX_ORDERS_PER_10_MIN=5

LOG_LEVEL=info
